# Copy to blinko.env (git-ignored) and fill in. Needed to sign the app for a device.
#   BLINKO_TEAM_ID   Apple Developer team id: Xcode > Settings > Accounts > your team,
#                    or `security find-identity -v -p codesigning` (the 10 characters in
#                    parentheses). A free Apple ID works: it allows 3 sideloaded apps.
#   BLINKO_BUNDLE_ID Bundle identifier to sign. Must be unique to you.
BLINKO_TEAM_ID=XXXXXXXXXX
BLINKO_BUNDLE_ID=com.example.blinko
